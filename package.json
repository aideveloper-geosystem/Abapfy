{
  "name": "abapfy",
  "version": "1.0.0",
  "description": "Abapfy — cliente desktop de chat com ferramentas para o ecossistema SAP/ABAP",
  "main": "./out/main/index.js",
  "author": "Abapfy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "validate:build-env": "node scripts/validate-build-env.mjs",
    "build": "pnpm validate:build-env && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:unpack": "pnpm build && electron-builder --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.25.3",
    "@supabase/supabase-js": "^2.45.4",
    "cross-spawn": "^7.0.6",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "pizzip": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.2",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zod": "3.25.76",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.1.2",
    "electron-builder": "^26.9.0",
    "electron-builder-squirrel-windows": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
