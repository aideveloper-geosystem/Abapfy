# Mesmo projeto Supabase do Abapfy (app desktop) — o dashboard lê as tabelas
# reais (profiles, chats, chat_messages) direto de lá, sem duplicar dado.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# NUNCA exponha esta chave ao client — só é lida em Server Components/Route
# Handlers/Server Actions (roda no Node, nunca no navegador). Ela ignora RLS:
# é o que permite o dashboard agregar dado de TODOS os usuários do Abapfy, não
# só o do admin logado. Pegue em Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
